HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/central.sqlite
NODE_ENV=development
AUTH_MODE=local
DATA_BACKEND=sqlite
SESSION_HOURS=8
COLLECTOR_TOKEN_MINUTES=30
RECALCULATE_INTERVAL_SECONDS=30
# Production: HTTPS reverse proxy; set APP_ORIGIN=https://your-real-domain
# Administrator setup: provide ADMIN_USERNAME and ADMIN_PASSWORD in your shell.
# No portal credentials are ever required or stored.
# For Google login and all business data in Google Sheet, use .env.google.example.
